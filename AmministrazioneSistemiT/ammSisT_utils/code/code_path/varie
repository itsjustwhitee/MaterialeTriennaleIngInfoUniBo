ldap_sync() {
    # $1 = REMOTE
    (
        ldapsearch -x -H "ldap://localhost" -b "ou=People,dc=labammsis" -s one
        ldapsearch -x -H "ldap://localhost" -b "ou=Groups,dc=labammsis" -s one
    ) |
    grep '^dn: ' | cut -c5- |
    ldapdelete -x -H "ldap://localhost" -D "$BINDDN" -w "$BINDPW"

    (
        ldapsearch -x -H "ldap://$1" -b "ou=People,dc=labammsis" -s one
        ldapsearch -x -H "ldap://$1" -b "ou=Groups,dc=labammsis" -s one
    ) |
    ldapadd -x -H "ldap://localhost" -D "$BINDDN" -w "$BINDPW"
}
--> per sincornizzare il contenuto della cartella ldap

find "$START_PATH" -name '*.c' -size +100k -exec cat {} \
--> per ogni file che rispetta certe caratteristiche (estensione .c e size maggiore di 100kB) trovato a partire da START_PATH, ne mostra il contenuto (cat).
    Nota: {} viene sostituito per ogni match con il percorso del file.
    Nota: \ indica la fine del comando (essenziale)
    
find "$START_PATH" -type f -nouser -mtime -2 -exec grep -l TXT {} \
--> elenca solo i file regolari (-type f) “orfani” (-nouser) modificati meno (-) di due (2) giorni (2*24 ore) fa che contengono TXT (grep -l TXT).
